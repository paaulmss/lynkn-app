PORT=4000
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key or legacy service_role key. Never use in VITE_*.
SUPABASE_KEY=replace-with-server-only-key
GEMINI_API_KEY=replace-with-moderation-key
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173,https://lynkn-app.vercel.app,capacitor://localhost,https://localhost,http://localhost
# Set to the exact number of trusted proxy hops in your deployment; 0 for local.
TRUST_PROXY_HOPS=0
